generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AnnouncementTarget {
  ALL
  STUDENTS
  INSTRUCTORS
  COURSE
}

enum CourseResourceType {
  LINK
  PDF
  VIDEO
  NOTE
  OTHER
}

enum DiscussionStatus {
  OPEN
  RESOLVED
}


model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments  Enrollment[]
  progress     Progress[]
  quizAttempts QuizAttempt[]
  certificates Certificate[]

  teachingCourses Course[]                     @relation("CourseInstructor")
  announcements Announcement[]                 @relation("AnnouncementAuthor")
  createdResources CourseResource[]            @relation("CourseResourceCreator")
  discussionThreads CourseDiscussion[]         @relation("DiscussionAuthor")
  discussionReplies CourseDiscussionReply[]    @relation("DiscussionReplyAuthor")
}

model Course {
  id          Int      @id @default(autoincrement())
  shortName   String
  title       String
  description String
  level       String
  category    String   @default("General")
  instructor  String

  instructorId   Int?
  instructorUser User? @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics              Topic[]
  lessons             Lesson[]
  enrollments         Enrollment[]
  quizzes             Quiz[]
  certificateTemplate CertificateTemplate?
  certificates        Certificate[]
  announcements       Announcement[]
  resources           CourseResource[]
  discussions         CourseDiscussion[]
}

model Topic {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  position    Int
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quizzes     Quiz[]
}

model Lesson {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  content     String     @default("")
  duration    String
  position    Int
  courseId    Int
  topicId     Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic       Topic?     @relation(fields: [topicId], references: [id])
  progress    Progress[]

  @@unique([courseId, position])
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseId   Int
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Progress {
  id          Int       @id @default(autoincrement())
  userId      Int
  lessonId    Int
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Quiz {
  id           Int            @id @default(autoincrement())
  title        String
  description  String
  passingScore Int            @default(60)
  courseId     Int
  topicId      Int?
  course       Course         @relation(fields: [courseId], references: [id])
  topic        Topic?         @relation(fields: [topicId], references: [id])
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model QuizQuestion {
  id            Int      @id @default(autoincrement())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String   @default("")
  points        Int      @default(1)
  position      Int
  quizId        Int
  quiz          Quiz     @relation(fields: [quizId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuizAttempt {
  id              Int      @id @default(autoincrement())
  userId          Int
  quizId          Int
  score           Int
  totalQuestions  Int
  correctAnswers  Int
  passed          Boolean
  selectedAnswers Json
  user            User     @relation(fields: [userId], references: [id])
  quiz            Quiz     @relation(fields: [quizId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, quizId])
}

model CertificateTemplate {
  id             Int      @id @default(autoincrement())
  courseId       Int      @unique
  title          String   @default("Certificate of Completion")
  subtitle       String   @default("This certificate is proudly presented to")
  bodyText       String   @default("for successfully completing the course")
  footerText     String   @default("Keep learning and growing with LearnTrack.")
  signatoryName  String   @default("Course Instructor")
  signatoryTitle String   @default("Instructor")
  brandColor     String   @default("#2563eb")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              Int      @id @default(autoincrement())
  certificateCode String   @unique
  userId          Int
  courseId        Int
  issuedAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}


model Announcement {
  id        Int                @id @default(autoincrement())
  title     String
  message   String
  target    AnnouncementTarget @default(ALL)
  courseId  Int?
  authorId  Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([target])
  @@index([courseId])
  @@index([authorId])
}

model CourseResource {
  id          Int                @id @default(autoincrement())
  title       String
  description String             @default("")
  resourceUrl String
  type        CourseResourceType @default(LINK)
  courseId    Int
  createdById Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation("CourseResourceCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([createdById])
  @@index([type])
}

model CourseDiscussion {
  id          Int              @id @default(autoincrement())
  title       String
  message     String
  status      DiscussionStatus @default(OPEN)
  courseId    Int
  authorId    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  course  Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author  User                    @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies CourseDiscussionReply[]

  @@index([courseId])
  @@index([authorId])
  @@index([status])
}

model CourseDiscussionReply {
  id           Int      @id @default(autoincrement())
  message      String
  discussionId Int
  authorId     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion CourseDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User             @relation("DiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([authorId])
}